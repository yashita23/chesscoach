# Chép thành backend/.env rồi điền giá trị. backend/.env đã nằm trong .gitignore.

# Token cá nhân Lichess (https://lichess.org/account/oauth/token), dùng để tải ván
# với giới hạn tốc độ cao hơn. Chess.com không cần key.
LICHESS_API_TOKEN=

# Tùy chọn: đổi file SQLite và kho bài tập.
# CHESSCOACH_DATABASE_URL=sqlite:///data/chesscoach.db
# CHESSCOACH_PUZZLE_CATALOG=data/puzzles.parquet
# Số lần giải đã có nhãn (toàn app) tối thiểu để bật hiệu chỉnh xác suất của mô hình năng lực.
# CHESSCOACH_CALIBRATION_MIN_ATTEMPTS=200
# Ghi đè cấu hình buổi luyện (các λ, giới hạn kỹ năng…), dạng JSON; xem PracticeConfig trong recommend.py.
# CHESSCOACH_PRACTICE_CONFIG={"lambda_exploration": 0.2}
