{
  "name": "chesscoach",
  "private": true,
  "scripts": {
    "setup": "uv --directory backend sync && npm --prefix frontend install",
    "dev": "concurrently -n api,web -c green,cyan \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "uv --directory backend run uvicorn chesscoach.main:app --reload --host 127.0.0.1 --port 8000",
    "dev:web": "npm --prefix frontend run dev",
    "test": "uv --directory backend run pytest",
    "typecheck": "uv --directory backend run mypy && npm --prefix frontend run typecheck"
  },
  "devDependencies": {
    "concurrently": "^9.2.0"
  }
}
